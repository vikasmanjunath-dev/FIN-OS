{
  "rewrites": [
    { "source": "/portfolio-analyser", "destination": "/Porfolio Analyser/portfolio-analyser-v10.html" },
    { "source": "/portfolio",          "destination": "/Porfolio Analyser/portfolio-analyser-v10.html" },
    { "source": "/trade-journal",      "destination": "/TradeJournal/index.html" },
    { "source": "/trades",             "destination": "/TradeJournal/index.html" },
    { "source": "/expense-tracker",    "destination": "/ExpenseTracker/finos-budget/index.html" },
    { "source": "/budget",             "destination": "/ExpenseTracker/finos-budget/index.html" },
    { "source": "/news",               "destination": "/News1/index.html" },
    { "source": "/chatbot",            "destination": "/chatbot/index.html" },
    { "source": "/voice",              "destination": "/voiceagent/index.html" },
    { "source": "/markets",            "destination": "/html/markets.html" },
    { "source": "/dashboard",          "destination": "/html/dashboard.html" },
    { "source": "/track",              "destination": "/html/track-finances.html" },
    { "source": "/benchmark",          "destination": "/html/benchmarking.html" },
    { "source": "/couple",             "destination": "/html/couple-finance.html" },
    { "source": "/timeline",           "destination": "/html/timeline.html" },
    { "source": "/money-ai",           "destination": "/html/money-ai.html" },
    { "source": "/report",             "destination": "/html/financial-report.html" },
    { "source": "/document-ai",        "destination": "/html/document-ai.html" },
    { "source": "/docs",               "destination": "/html/document-ai.html" },
    { "source": "/hub",                "destination": "/html/financial-hub.html" },
    { "source": "/command-hub",        "destination": "/html/financial-hub.html" }
  ],
  "redirects": [
    {
      "source": "/Porfolio%20Analyser/portfolio-analyser-v9.html",
      "destination": "/portfolio-analyser",
      "permanent": true
    },
    {
      "source": "/Porfolio%20Analyser/portfolio-analyser-v10.html",
      "destination": "/portfolio-analyser",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-NFz6W0UOHLiVJhj6IcWw/HBjCf4CiXKX+URrtBHyAHg=' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co http://localhost:* ws://localhost:* https://openrouter.ai https://fonts.googleapis.com; img-src 'self' data: https: blob:; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), bluetooth=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy","value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/css/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
