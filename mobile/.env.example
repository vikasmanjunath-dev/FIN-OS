# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* at build time (restart `expo start` after editing).
# Supabase dashboard → Project Settings → API. Use the *anon / public* key — never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
