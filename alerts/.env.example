# FIN-OS Alert Engine — Environment Variables
# Copy this to .env and fill in your values

# Supabase (use SERVICE ROLE key so the engine can read all users)
SUPABASE_URL=https://oeapcyucnduhwpgxfknb.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# VAPID Keys for Web Push Notifications
# Generate with:
#   pip install py-vapid
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_key); print('PUBLIC:', v.public_key)"
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Operator key for POST /alerts/run and for server-to-server callers (the voice agent sends it as X-Admin-Key).
# Unset = /alerts/run is disabled. Use a long random value; never commit it.
ADMIN_API_KEY=
# Authentication of user routes: "required" (default) or "off" (local development only, logs a CRITICAL warning).
ALERTS_AUTH=required
# Extra browser origins allowed by CORS (comma separated; localhost on any port is always allowed). Never "*".
ALERTS_CORS=https://finos1.vercel.app
