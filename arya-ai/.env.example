# Arya AI — Environment Config
# Copy to .env and edit as needed. All values have safe defaults.

# Server
ARYA_PORT=7475
ARYA_HOST=0.0.0.0
ARYA_CORS=http://localhost:7474,http://127.0.0.1:7474

# Ollama (local AI — no API key needed)
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Cache TTLs in seconds (tune for your machine)
TTL_QUOTE=10
TTL_INDEX=15
TTL_MF_NAV=3600
TTL_GOLD=300
TTL_CRYPTO=60
TTL_FX=300
TTL_NEWS=600
TTL_SEARCH=300
TTL_TECHNICAL=300

# Supabase — ONLY used by GET /api/portfolio/summary. Every other endpoint in
# this service is public market data with no user namespace, so leaving these
# blank just means /api/portfolio/summary returns a clear "not configured"
# error instead of breaking anything else. Reuse the same project's anon key
# already used elsewhere in FIN-OS (e.g. alerts/.env) — do not create a new one.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Browser origins allowed by CORS (comma separated; localhost / 127.0.0.1 on any port are always allowed). Never "*".
# ARYA_CORS=http://localhost:7474,http://127.0.0.1:7474,https://finos1.vercel.app
# Rate limits "group=requests/seconds", or "off". Groups: chat tts fetch report portfolio tool global.
# ARYA_RATE_LIMITS=chat=10/60,tts=20/60
# Set to 1 ONLY when the service is reachable only through the bundled nginx gateway (it overwrites X-Real-IP).
# ARYA_TRUST_PROXY=1
# Enables POST /api/cache/clear (sent as X-Admin-Token). Unset = that route is disabled. Use a long random value.
# ARYA_ADMIN_TOKEN=
